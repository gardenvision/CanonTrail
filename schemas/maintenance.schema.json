{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canontrail:schema:maintenance:1",
  "title": "Documentation Maintenance Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "created",
    "cadence",
    "mode",
    "remote_required",
    "checks",
    "mutation_policy"
  ],
  "properties": {
    "version": { "const": 1 },
    "created": { "type": "string", "format": "date" },
    "cadence": { "type": "string", "minLength": 1 },
    "mode": { "const": "report-first" },
    "remote_required": { "const": false },
    "stale_after_days": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical": { "$ref": "#/$defs/threshold" },
        "design-target": { "$ref": "#/$defs/threshold" },
        "active-snapshot": { "$ref": "#/$defs/threshold" },
        "draft": { "$ref": "#/$defs/threshold" },
        "historical": { "$ref": "#/$defs/threshold" }
      }
    },
    "future_date_tolerance_days": { "type": "integer", "minimum": 0 },
    "frozen_examples": {
      "description": "Explicit hash-bound synthetic examples; affects age freshness only, never validation or canonical authority. Eligibility is checked against actual indexed files.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_hash", "rationale"],
        "properties": {
          "path": { "type": "string", "pattern": "^examples/.+\\.[mM][dD]$" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "rationale": { "type": "string", "minLength": 10 }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "mutation_policy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "threshold": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
