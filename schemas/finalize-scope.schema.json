{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canontrail:schema:finalize-scope:1",
  "title": "Finalization completion scope (report only)",
  "description": "Additive report contract, not a persisted project artifact or execution permission. Raw repository diagnostics and failure remain unchanged. Only validator-classified unrelated context drift can be deferred for task completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "relevant_task_ids", "fallback_reason", "deferred_findings"],
  "properties": {
    "mode": { "enum": ["repository", "task"] },
    "relevant_task_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fallback_reason": { "type": ["string", "null"] },
    "deferred_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "path", "context_drift"],
        "properties": {
          "code": { "enum": ["LOCK004", "LOCK008"] },
          "severity": { "const": "error" },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "detail": { "type": "string" },
          "context_drift": {
            "type": "object", "additionalProperties": false, "required": ["task_id", "kind"],
            "properties": { "task_id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["source-content", "task-requirements"] } }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "mode": { "const": "repository" } } }, "then": { "properties": { "deferred_findings": { "type": "array", "maxItems": 0 } } } },
    { "if": { "properties": { "mode": { "const": "task" } } }, "then": { "properties": { "fallback_reason": { "type": "null" }, "relevant_task_ids": { "type": "array", "minItems": 1 } } } }
  ]
}
