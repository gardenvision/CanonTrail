{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canontrail:schema:task-state:0",
  "title": "Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "objective",
    "acceptance_criteria",
    "dependencies",
    "file_intents",
    "checks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^FEAT-[A-Z0-9-]+$"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "claimed",
        "in-progress",
        "blocked",
        "review",
        "verified",
        "done",
        "superseded"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "not-applicable"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documentation_impact": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "file_intents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_context_sources": {
      "description": "Existing repository-relative text sources that must be present in every compiled context for this task. Unlike file_intents, these are hard inputs rather than a potentially broad change surface.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "parallel_safety": {
      "enum": [
        "safe",
        "conditional",
        "exclusive",
        "unknown"
      ]
    },
    "owner": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "lease_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "agent_id",
        "session_id",
        "claimed_at"
      ],
      "additionalProperties": false
    },
    "worktree": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "branch",
        "base_revision",
        "dirty"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command_or_observation",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command_or_observation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "latest_handoff": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "context_sections": {
      "description": "Explicit one-range-per-source selection. Cannot narrow mandatory whole-file sources. Full source hash must match before compilation; line numbers are 1-based inclusive.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "from",
          "to",
          "content_hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "integer",
            "minimum": 1
          },
          "to": {
            "type": "integer",
            "minimum": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
